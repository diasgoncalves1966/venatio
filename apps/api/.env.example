# Database
DATABASE_URL=postgresql://venatio:venatio@localhost:5432/venatio?schema=public

# API
PORT=3001
NODE_ENV=development

# Auth
JWT_SECRET=venatio_dev_jwt_secret_change_me
JWT_EXPIRES_IN=7d

# Public URL used in local uploaded image links (fallback when S3 is off)
PUBLIC_API_URL=http://localhost:3001

# Object storage (S3 / Cloudflare R2). When set, uploads go here instead of local disk.
# S3_BUCKET=venatio-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=venatio_dev_master_key_change_me
