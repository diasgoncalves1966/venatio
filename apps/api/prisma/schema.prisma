generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  ARCHIVED
}

model Group {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("groups")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  listings  Listing[]

  @@map("categories")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  bio          String?
  city         String?
  country      String?   @default("PT")
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id])
  /// WGS84 latitude (PostGIS geometry can replace this later)
  latitude     Float?
  /// WGS84 longitude
  longitude    Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  listings     Listing[]
  favorites    Favorite[]

  @@index([city])
  @@index([groupId])
  @@map("users")
}

model Listing {
  id          String           @id @default(cuid())
  title       String
  description String
  priceCents  Int
  currency    String           @default("EUR")
  condition   ListingCondition
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  status      ListingStatus    @default(DRAFT)
  city        String?
  country     String?          @default("PT")
  latitude    Float?
  longitude   Float?
  sellerId    String
  seller      User             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images      ListingImage[]
  favorites   Favorite[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, categoryId])
  @@index([sellerId])
  @@index([priceCents])
  @@map("listings")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("favorites")
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_images")
}
